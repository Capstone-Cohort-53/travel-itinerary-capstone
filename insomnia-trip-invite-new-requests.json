    {
      "_type": "request",
      "parentId": "wrk_invite_only",
      "metaSortKey": 6,
      "body": {},
      "authentication": {},
      "_id": "req_invite_get_one",
      "name": "6. GET one invite by id",
      "method": "GET",
      "url": "http://lauren.ddfullstack.cloud:8080/apis/trip/{{ _.trip_id }}/invite/{{ _.invite_id }}",
      "headers": [
